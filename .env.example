# Copia este archivo como .env y completa los valores (el .env NO se sube a GitHub)
# Clave secreta: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_DEBUG=1
COOKIES_SEGURAS=0
SITIO_URL=/

DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=BeitShalomDB
# Con Windows: DB_TRUSTED=1 y deja usuario/contraseña vacíos. Con usuario SQL: DB_TRUSTED=0
DB_TRUSTED=1
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_CERT=yes
DB_TIMEOUT=10
